# PlatformIO Project Configuration File
.pio

# Visual Studio Code related files
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.vscode/extensions.json
*.code-workspace
*.ans

# ESP-IDF Component Manager
managed_components/

# Runtime monitor logs on gateways
logs/
logs_testbed/

# Python bytecode (configtool package)
__pycache__/
*.pyc

# Testbed experiment configs (contain credentials) and generated scripts.
# The sanitised template is allow-listed so users have a starting point.
scripts/testbed/experiments/*.yaml
!scripts/testbed/experiments/example-baseline.yaml
scripts/testbed/change-config/*.sh

# OTA test fixtures: firmware images and generated patch chunks.
# Regenerable via scripts/ota_tools (generate_patch.py / split_chunks.py).
test_firmware/
# Testbed gateway inventory (SSH hosts/passwords). Copy testbed.conf.example.
scripts/testbed/testbed.conf

# Experiment output and orchestrator logs
new_sims4/
*.log
scripts/testbed/docs/

# Paper working material (lives in the loramesher repo)
docs/paper/*
!docs/paper/sf_offered_load_capacity.md
docs/compliance/
docs/debate/
docs/paper_lorachat/
docs/compass_artifact_*.md
docs/formation_convergence_floor.md

# Local assistant notes
CLAUDE.md
CONTINUE.md

# Site settings with credentials. Template: src/config_local.example.h
src/config_local.h

# Collected release and bench images (scripts/ota_tools/release.py)
release/
